# Generated on every build; the module exists to compile and run what the
# domain rules write over MyBatis, not to keep it. What is committed is the
# blueprint and the tests.
src/main/java/**
# ... but the hand-written domain service, listeners and order rules (they replace domainService:,
# processManager: and @specification, issue 370).
!src/main/java/**/
!src/main/java/io/elasticore/sample/dddmybatis/shop/domain/service/PricingService.java
!src/main/java/io/elasticore/sample/dddmybatis/shop/domain/model/OrderRules.java
!src/main/java/io/elasticore/sample/dddmybatis/shop/application/LoyaltyListener.java
!src/main/java/io/elasticore/sample/dddmybatis/billing/application/ReceiptingListener.java
src/test/java/io/
/src/main/resources/io/
/src/main/resources/db/

# The message bundle the generator writes beside the error handler.
/src/main/resources/i18n/*-messages.properties

# What the generator last wrote, merged against (elasticore-env-guide.md 9-2). A project
# commits it with its generated files; this one keeps most of those out of git and
# regenerates them on every build, so the base (.elasticore/generated-base.zip) stays local with them.
/.elasticore/
