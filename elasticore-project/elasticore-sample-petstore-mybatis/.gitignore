# What the generator writes is regenerated by every build; only the files
# the developer owns - written once, then edited - are kept.
/src/main/java/**/*.java
!/src/main/java/io/elasticore/sample/mybatis/petstore/*.java
!/src/main/java/io/elasticore/sample/mybatis/petstore/application/PurchaseOrderService.java

# The mapper XML and the schemas, written by every build.
/src/main/resources/io/
/src/main/resources/db/

/src/main/resources/blueprint/*.md
/src/main/resources/blueprint/schema.yml

# The message bundle the generator writes beside the error handler.
/src/main/resources/i18n/*-messages.properties
