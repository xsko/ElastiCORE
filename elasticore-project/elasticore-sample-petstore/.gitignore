# What the generator writes is regenerated by every build; only the files
# the developer owns - written once, then edited - are kept.
/src/main/java/**/*.java
!/src/main/java/io/elasticore/sample/petstore/*.java
!/src/main/java/io/elasticore/sample/petstore/domain/model/PurchaseOrder.java
!/src/main/java/io/elasticore/sample/petstore/domain/model/OrderLine.java
!/src/main/java/io/elasticore/sample/petstore/application/PurchaseOrderService.java
!/src/main/java/io/elasticore/sample/petstore/application/CustomerService.java
!/src/main/java/io/elasticore/sample/petstore/adapter/in/web/shop/*.java

/src/main/ts/
/src/main/resources/blueprint/*.md
/src/main/resources/blueprint/schema.yml
/src/main/resources/static/app.js
/src/main/resources/static/app.js.map

# The repository ignores these everywhere; the sample's are its own.
web/node_modules/
!web/package.json
!web/package-lock.json
!src/main/resources/static/images/*.jpg

# The message bundle the generator writes beside the error handler; a
# translation next to it (..._ko.properties) is the developer's and is kept.
/src/main/resources/i18n/*-messages.properties

# What the generator last wrote, merged against (elasticore-env-guide.md 9-2). A project
# commits it with its generated files; this one keeps most of those out of git and
# regenerates them on every build, so the cache stays local with them.
/.elasticore/
