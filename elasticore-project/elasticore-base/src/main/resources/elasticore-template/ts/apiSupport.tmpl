/** One page of results, as Spring Data serialises it. */
export interface Page<T> {
    content: T[];
    totalElements: number;
    totalPages: number;
    number: number;
    size: number;
    first: boolean;
    last: boolean;
}

let baseUrl = '';
let sender: typeof fetch | undefined;
let defaults: RequestInit | (() => RequestInit | Promise<RequestInit>) | undefined;

/** Where the API lives. Call once at startup; defaults to same-origin. */
export function setApiBaseUrl(url: string): void {
    baseUrl = url.replace(/\/+$/, '');
}

/**
 * What every request carries, and the fetch that sends it. Call once at startup.
 *
 * - baseUrl: as setApiBaseUrl.
 * - fetch: the function that sends - a test's own, or a server framework's.
 * - init: headers, credentials ('include' for an API on another origin) ... merged
 *   into every request, its headers over Content-Type. A function is called for each
 *   request: a server reads the incoming request's cookie there (from its request
 *   context, such as AsyncLocalStorage - this setting is shared by every request a
 *   server handles at once). For what belongs to one call only, pass init to that call.
 */
export function configureApi(options: {
    baseUrl?: string;
    fetch?: typeof fetch;
    init?: RequestInit | (() => RequestInit | Promise<RequestInit>);
}): void {
    if (options.baseUrl !== undefined) setApiBaseUrl(options.baseUrl);
    if (options.fetch !== undefined) sender = options.fetch;
    if (options.init !== undefined) defaults = options.init;
}

/** What the server answers a refused request with (RFC 9457). */
export interface ProblemDetail {
    type?: string;
    title?: string;
    status?: number;
    detail?: string;
    instance?: string;
    /** What was refused, for a program to branch on: not-found, invalid, state.Order.status.ship ... */
    code?: string;
    /** "field: message" for each field a 400 found wrong. */
    errors?: string[];
    /** The same, as data: the field, the constraint (NotNull, Size ...) and the message in the request's language. */
    fieldErrors?: { field: string; code?: string; message?: string }[];
    [key: string]: unknown;
}

/** Raised for any response the server did not answer 2xx to. */
export class ApiError extends Error {
    /** The problem detail the server sent, when it sent one. */
    readonly problem?: ProblemDetail;
    /** Field -> message, from a 400's errors: what a form shows beside each field. */
    readonly fieldErrors: Record<string, string> = {};

    constructor(readonly status: number, readonly path: string, message: string) {
        super(message);
        this.name = 'ApiError';
        try {
            const parsed = JSON.parse(message);
            if (parsed && typeof parsed === 'object') {
                this.problem = parsed as ProblemDetail;
                if (Array.isArray(this.problem.fieldErrors)) {
                    for (const e of this.problem.fieldErrors) {
                        if (e && e.field) this.fieldErrors[e.field] = String(e.message ?? '');
                    }
                } else {
                    // A server from before fieldErrors: "field: message" strings.
                    for (const entry of this.problem.errors ?? []) {
                        const text = String(entry);
                        const colon = text.indexOf(': ');
                        if (colon > 0) this.fieldErrors[text.slice(0, colon)] = text.slice(colon + 2);
                    }
                }
            }
        } catch {
            // not JSON: the message is the body as it came
        }
    }

    /** What was refused, as a code: the problem's "code", if the server sent one. */
    get code(): string | undefined {
        return typeof this.problem?.code === 'string' ? this.problem.code : undefined;
    }

    /** What to tell the user: the problem's detail, else its title, else the status. */
    get detail(): string {
        // Concatenated: a template literal would read as a slot of the skeleton.
        return this.problem?.detail ?? this.problem?.title ?? 'HTTP ' + this.status;
    }
}

/** Content-Type, then the shared headers, then the call's: a later one wins, whatever its case. */
function headersOf(shared?: RequestInit, init?: RequestInit): Record<string, string> {
    const merged = new Headers({ 'Content-Type': 'application/json' });
    for (const given of [shared?.headers, init?.headers]) {
        if (given) new Headers(given).forEach((value, key) => merged.set(key, value));
    }
    const out: Record<string, string> = {};
    merged.forEach((value, key) => { out[key] = value; });
    return out;
}

async function send(method: string, path: string, body?: unknown, init?: RequestInit): Promise<Response> {
    const shared = typeof defaults === 'function' ? await defaults() : defaults;
    const doFetch = sender ?? fetch;
    return doFetch(baseUrl + path, {
        ...shared,
        ...init,
        method,
        headers: headersOf(shared, init),
        body: body === undefined ? undefined : JSON.stringify(body),
    });
}

/**
 * The body as JSON, or undefined when there is none: a 204, and a 200 with an
 * empty body - what a void endpoint answers with ResponseEntity.ok().build(),
 * as the batch update does.
 */
async function bodyOf(res: Response): Promise<unknown> {
    const text = await res.text();
    return text === '' ? undefined : JSON.parse(text);
}

export async function request<T>(method: string, path: string, body?: unknown, init?: RequestInit): Promise<T> {
    const res = await send(method, path, body, init);
    if (!res.ok) {
        throw new ApiError(res.status, path, await res.text());
    }
    return (await bodyOf(res)) as T;
}

/** The same, where the server has nothing to return: a 404, or no body. */
export async function requestOrNull<T>(method: string, path: string, init?: RequestInit): Promise<T | null> {
    const res = await send(method, path, undefined, init);
    if (res.status === 404) {
        return null;
    }
    if (!res.ok) {
        throw new ApiError(res.status, path, await res.text());
    }
    const found = await bodyOf(res);
    return found === undefined ? null : (found as T);
}

/** A path segment a caller supplied, which may contain anything. */
export function seg(value: string | number | boolean): string {
    return encodeURIComponent(String(value));
}
