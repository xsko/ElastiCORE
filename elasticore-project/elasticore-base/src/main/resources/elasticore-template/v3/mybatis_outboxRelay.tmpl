package ${packageName};

${importList}
import io.elasticore.springboot3.outbox.OutboxEnvelope;
import io.elasticore.springboot3.outbox.OutboxPublisher;
import java.time.Duration;
import java.time.Instant;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.ObjectProvider;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;
import org.springframework.transaction.PlatformTransactionManager;
import org.springframework.transaction.TransactionDefinition;
import org.springframework.transaction.support.TransactionTemplate;
import org.springframework.transaction.annotation.Transactional;

/**
 * Sends what the outbox holds, oldest first, through the application's
 * OutboxPublisher, and marks each message published when that succeeds.
 *
 * Settings (application properties):
 *   elasticore.outbox.relay-delay-ms   how often relay() runs (default 5000)
 *   elasticore.outbox.max-attempts     tries before a message is set aside (default 10)
 *   elasticore.outbox.retention-days   how long sent messages are kept (default 7)
 *   elasticore.outbox.purge-delay-ms   how often purge() runs (default 3600000)
 * The schedules run when the application enables scheduling; both methods
 * can be called directly.
 *
 * A failed send stops the batch, so messages leave in the order they were
 * raised, and is tried again next time. A message that fails max-attempts
 * times is set aside (parked) with its last error, so one message the broker
 * refuses cannot hold back every one after it. Delivery is at least once.
 * Several instances may run the relay: each takes rows the others have not
 * locked.
 *
 * Generated by ElastiCORE. Do not edit outside the ElastiCORE guidelines.
 */
@Component
public class ${className} {

    private static final Logger log = LoggerFactory.getLogger(${className}.class);

    private final ${repositoryName} outbox;
    private final ObjectProvider<OutboxPublisher> publisher;
    private final int maxAttempts;
    private final int retentionDays;
    /** Runs the send outside the relay transaction, so a publisher that fails cannot mark it for rollback. */
    private final TransactionTemplate outside;

    public ${className}(${repositoryName} outbox, ObjectProvider<OutboxPublisher> publisher,
                        PlatformTransactionManager transactions,
                        @Value("${maxAttemptsProperty}") int maxAttempts,
                        @Value("${retentionProperty}") int retentionDays) {
        this.outbox = outbox;
        this.publisher = publisher;
        this.maxAttempts = maxAttempts;
        this.retentionDays = retentionDays;
        this.outside = new TransactionTemplate(transactions);
        this.outside.setPropagationBehavior(TransactionDefinition.PROPAGATION_NOT_SUPPORTED);
    }

    /** Publishes pending messages; answers how many went out. */
    @Scheduled(fixedDelayString = "${relayDelay}")
    @Transactional
    public int relay() {
        OutboxPublisher target = publisher.getIfAvailable();
        if (target == null) return 0;
        int sent = 0;
        for (${messageName} m : outbox.findTop100ByPublishedAtIsNullAndAttemptsLessThanOrderByIdAsc(maxAttempts)) {
            try {
                OutboxEnvelope envelope = new OutboxEnvelope(m.getId(), m.getAggregateType(), m.getAggregateId(),
                        m.getEventType(), m.getPayload(), m.getOccurredOn());
                Exception[] failure = new Exception[1];
                outside.executeWithoutResult(status -> {
                    try {
                        target.publish(envelope);
                    } catch (Exception e) {
                        failure[0] = e;
                    }
                });
                if (failure[0] != null) throw failure[0];
                m.setPublishedAt(Instant.now());
                m.setLastError(null);
                // Written, not tracked: MyBatis writes what it is told to.
                outbox.update(m);
                sent++;
            } catch (Exception e) {
                m.setAttempts(m.getAttempts() + 1);
                String error = String.valueOf(e);
                m.setLastError(error.length() > 500 ? error.substring(0, 500) : error);
                outbox.update(m);
                if (m.getAttempts() >= maxAttempts) {
                    // Set aside: the next run starts with the message after it.
                    log.error("outbox message {} ({}) parked after {} attempts: {}",
                            m.getId(), m.getEventType(), m.getAttempts(), error);
                    continue;
                }
                log.warn("outbox message {} ({}) not published, attempt {}: {}",
                        m.getId(), m.getEventType(), m.getAttempts(), error);
                break;
            }
        }
        return sent;
    }

    /** Removes sent messages older than the retention; answers how many. */
    @Scheduled(fixedDelayString = "${purgeDelay}")
    @Transactional
    public int purge() {
        return outbox.deletePublishedBefore(Instant.now().minus(Duration.ofDays(retentionDays)));
    }

    /** How many messages are waiting to be sent (parked ones included). */
    @Transactional(readOnly = true)
    public long pending() {
        return outbox.countByPublishedAtIsNull();
    }

    /** How many messages failed every attempt and wait for someone to look at them. */
    @Transactional(readOnly = true)
    public long parked() {
        return outbox.countByPublishedAtIsNullAndAttemptsGreaterThanEqual(maxAttempts);
    }
}
