# Generated by elcore3ddd on demand; the module exists to compile what the
# DDD rules produce, not to keep it. What is committed is the blueprint.
src/main/java/**
# ... but the board's PostService, the sample's own (its cleanContent / plainContent, issue 217).
!src/main/java/**/
!src/main/java/io/elasticore/sample/ddd/board/application/PostService.java
# ... and the hand-written domain service, listeners and order rules (they replace domainService:,
# processManager: and @specification, issue 370).
!src/main/java/io/elasticore/sample/ddd/shop/domain/service/PricingService.java
!src/main/java/io/elasticore/sample/ddd/shop/domain/model/OrderRules.java
!src/main/java/io/elasticore/sample/ddd/shop/application/LoyaltyListener.java
!src/main/java/io/elasticore/sample/ddd/billing/application/ReceiptingListener.java
src/test/java/io/**
# ... but the forum's contract support class, which the sample wrote newSignInRow in.
!src/test/java/io/**/
!src/test/java/io/**/forum/ForumContractSupport.java
# ... and the class in domain.service the architecture test must refuse (DomainServiceArchitectureTest).
!src/test/java/io/**/shop/domain/service/WebAwarePricing.java

# The message bundle the generator writes beside the error handler; a
# translation next to it (..._ko.properties) is the developer's and is kept.
/src/main/resources/i18n/*-messages.properties

# What the generator last wrote, merged against (elasticore-env-guide.md 9-2). A project
# commits it with its generated files; this one keeps most of those out of git and
# regenerates them on every build, so the base (.elasticore/generated-base.zip) stays local with them.
/.elasticore/
