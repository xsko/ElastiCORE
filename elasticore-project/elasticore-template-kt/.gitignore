# Generated by elcore3kt / elcore3ts on demand; the module exists to compile
# them, not to keep them.
src/main/kotlin/**
# ... but the content domain's CommentService, the sample's own (its cleanContent / plainContent, issue 217).
!src/main/kotlin/**/
!src/main/kotlin/io/elasticore/blueprint/domain/content/service/CommentService.kt
# ... and the hand-written domain service, listener and order rules (they replace domainService:,
# processManager: and @specification, issue 370).
!src/main/kotlin/io/elasticore/blueprint/domain/shop/domainservice/PricingService.kt
!src/main/kotlin/io/elasticore/blueprint/domain/shop/entity/OrderRules.kt
!src/main/kotlin/io/elasticore/blueprint/domain/shop/service/LoyaltyListener.kt
src/test/kotlin/io/**
# ... but the contract tests' support class, which the sample edited (it names the application).
!src/test/kotlin/io/**/
!src/test/kotlin/io/**/*ContractSupport.kt
src/main/ts/*.ts
src/main/ts/node_modules/
# The pinned TypeScript compiler is tracked. The root .gitignore excludes
# package.json and package-lock.json everywhere - a Node project's noise -
# and these two are the opposite of noise: a type check that resolves a
# different compiler on each machine is not one check.
!src/main/ts/package.json
!src/main/ts/package-lock.json
src/main/ts/build/

# The message bundle the generator writes beside the error handler; a
# translation next to it (..._ko.properties) is the developer's and is kept.
/src/main/resources/i18n/*-messages.properties
# The label bundle, every file of it generated (OrderStatus's name_ko, name_zh_TW columns).
/src/main/resources/i18n/*-labels.properties
/src/main/resources/i18n/*-labels_*.properties

# What the generator last wrote, merged against (elasticore-env-guide.md 9-2). A project
# commits it with its generated files; this one keeps most of those out of git and
# regenerates them on every build, so the base (.elasticore/generated-base.zip) stays local with them.
/.elasticore/
