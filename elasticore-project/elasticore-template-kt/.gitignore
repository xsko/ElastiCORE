# Generated by elcore3kt / elcore3ts on demand; the module exists to compile
# them, not to keep them.
src/main/kotlin/
src/test/kotlin/io/
src/main/ts/*.ts
src/main/ts/node_modules/
# The pinned TypeScript compiler is tracked. The root .gitignore excludes
# package.json and package-lock.json everywhere - a Node project's noise -
# and these two are the opposite of noise: a type check that resolves a
# different compiler on each machine is not one check.
!src/main/ts/package.json
!src/main/ts/package-lock.json
src/main/ts/build/

# The message bundle the generator writes beside the error handler; a
# translation next to it (..._ko.properties) is the developer's and is kept.
/src/main/resources/i18n/*-messages.properties

# What the generator last wrote, merged against (elasticore-env-guide.md 9-2). A project
# commits it with its generated files; this one keeps most of those out of git and
# regenerates them on every build, so the cache stays local with them.
/.elasticore/
